// Dolphone on a desktop: the same phone, for a monitor, mouse and keyboard.
//
// A sidebar for the four places (Calls, Messages, Contacts, Settings), and over
// everything, the things that cannot wait: a ringing call, the live call, and a
// confirmation phoned is holding. Nothing here knows about ModemManager; it all
// comes from phoned through Rust, which fills these models and answers these
// callbacks.
import { Button, LineEdit, ListView, ComboBox, CheckBox, Switch, ScrollView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

export struct Row {
    // The line in bold, the line under it, what sits at the right.
    title: string,
    subtitle: string,
    aside: string,
    // A dot: 0 none, 1 unread or missed, 2 a warning (failed, blocked).
    mark: int,
    // What the dot means, in words, for a screen reader ("2 unread", "blocked").
    note: string,
    key: string,
}

export struct Bubble {
    text: string,
    time: string,
    mine: bool,
    state: string,
    // A one-time code found in the text, for its Copy button.
    code: string,
    // An MMS's first picture, and a line naming what else it carried.
    picture: image,
    parts: string,
    // The whole bubble in words: who, when, how it went, then the text.
    label: string,
}

// An ON/OFF setting: its key in phoned, what it says, whether it is on.
export struct Toggle {
    key: string,
    label: string,
    on: bool,
}

export struct Choice {
    label: string,
    value: string,
}

export global Brand {
    // The Flipper's orange, kept for the one thing that should catch the eye.
    out property <color> accent: #ff8200;
    out property <color> danger: #c23b3b;
    out property <color> ok: #217a45;
    // Your own bubbles: the orange darkened until white text on it reads (4.6:1).
    out property <color> bubble: #b35400;
    // Secondary text: the theme's own ink, lightened, so it holds about 4.5:1 in
    // both light and dark themes where a fixed grey would fail one of them.
    out property <color> muted: Palette.foreground.with-alpha(0.68);
    // The keyboard focus ring on what is drawn here rather than by the style.
    out property <color> focus: Palette.accent-background;
}

// A control drawn here rather than by the style, made to behave like a Button for
// the keyboard: Tab stops on it, Enter or Space presses it, and a ring shows where
// the focus is. The control's look goes inside; `hovered` and `down` are for it.
component Pressable inherits FocusScope {
    in property <length> radius;
    in property <string> label;
    out property <bool> hovered: touch.has-hover;
    out property <bool> down: touch.pressed;
    callback activated();
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.activated(); }
    key-pressed(event) => {
        // Ctrl+Enter and the like are the window's shortcuts, not a press.
        if (root.enabled && !event.modifiers.control && (event.text == Key.Return || event.text == " ")) {
            root.activated();
            return accept;
        }
        reject
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
    @children
    if root.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: root.radius + 3px;
        border-width: 2px;
        border-color: Brand.focus;
    }
}

// Where Tab lands past an overlay's last control, or Shift+Tab before its first:
// it hands the focus straight back inside, so the keyboard cannot wander off
// behind the dim layer to the page underneath.
component FocusWrap inherits FocusScope {
    callback wrap();
    x: 0;
    y: 0;
    width: 1px;
    height: 1px;
    focus-gained(reason) => { root.wrap(); }
}

component Badge inherits Rectangle {
    in property <int> count;
    visible: count > 0;
    width: max(18px, label.preferred-width + 10px);
    height: 18px;
    border-radius: 9px;
    background: Brand.accent;
    label := Text {
        text: count;
        color: white;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> active;
    in property <int> badge;
    callback clicked();
    height: 40px;
    border-radius: 8px;
    accessible-role: button;
    accessible-label: badge > 0 ? label + ", " + badge + " new" : label;
    accessible-action-default => { root.clicked(); }
    background: active ? Palette.selection-background : touch.has-hover ? Palette.alternate-background : transparent;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        Text { text: glyph; font-size: 16px; vertical-alignment: center; color: active ? Palette.selection-foreground : Palette.foreground; }
        Text { text: label; vertical-alignment: center; horizontal-stretch: 1; font-weight: active ? 600 : 400; color: active ? Palette.selection-foreground : Palette.foreground; }
        VerticalLayout { alignment: center; Badge { count: badge; } }
    }
}

component RowView inherits Rectangle {
    in property <Row> entry;
    in property <bool> selected;
    // The keyboard is on this row: it takes the focus.
    in property <bool> current;
    in property <string> primary-label;
    // A click or Space; a double click, Enter, or the row's button.
    callback clicked();
    callback primary();
    // Up or Down (-1, 1), for the list to move along; and the row took the focus.
    callback step(int);
    callback focused();
    property <bool> button-focused;
    property <bool> active: fs.has-focus || root.button-focused;
    height: 56px;
    border-radius: 8px;
    background: selected ? Palette.selection-background : touch.has-hover || root.active ? Palette.alternate-background : transparent;
    changed current => {
        if (root.current) { fs.focus(); }
    }
    fs := FocusScope {
        // On the scope, which is what has the focus. The dot's colour says
        // unread, missed or blocked; the label says it in words.
        accessible-role: list-item;
        accessible-label: (entry.note != "" ? entry.note + ", " : "") + entry.title + ", " + entry.subtitle + ", " + entry.aside;
        accessible-action-default => { root.primary(); }
        key-pressed(event) => {
            if (event.modifiers.control) { return reject; }
            if (event.text == Key.Return) { root.primary(); return accept; }
            if (event.text == " ") { root.clicked(); return accept; }
            if (event.text == Key.UpArrow) { root.step(-1); return accept; }
            if (event.text == Key.DownArrow) { root.step(1); return accept; }
            reject
        }
        focus-gained(reason) => { root.focused(); }
        touch := TouchArea {
            clicked => { root.clicked(); }
            double-clicked => { root.primary(); }
        }
    }
    HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px; height: 8px; border-radius: 4px;
                background: entry.mark == 1 ? Brand.accent : entry.mark == 2 ? Brand.danger : transparent;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: entry.title; font-weight: entry.mark == 1 ? 700 : 500; overflow: elide; color: selected ? Palette.selection-foreground : Palette.foreground; }
            Text { text: entry.subtitle; font-size: 12px; overflow: elide; color: selected ? Palette.selection-foreground : Brand.muted; }
        }
        Text { text: entry.aside; font-size: 12px; vertical-alignment: center; color: selected ? Palette.selection-foreground : Brand.muted; }
        // Shown on hover, on the selected row, and on the row the keyboard is on
        // (or on the button itself, which Tab reaches next).
        if primary-label != "" && (touch.has-hover || selected || root.active): Button {
            text: primary-label;
            clicked => { root.primary(); }
            changed has-focus => { root.button-focused = self.has-focus; }
        }
    }
    if fs.has-focus: Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Brand.focus;
    }
}

// A scrolling list of rows the keyboard can walk: Tab enters it, Up and Down move
// along it (scrolling as they go), Enter does the row's main thing and Space
// chooses it.
component RowList inherits ListView {
    in property <[Row]> rows;
    in property <int> selected: -1;
    in property <string> primary-label;
    callback chosen(int);
    callback primary(int);
    // The row the keyboard is on, which the focus follows.
    property <int> cursor: -1;
    property <length> row-height: 56px;

    function go(i: int) {
        if (i < 0 || i >= root.rows.length) { return; }
        // Scrolled to first, so the row is there to take the focus.
        if (i * root.row-height < -root.content-y) {
            root.content-y = -i * root.row-height;
        }
        if ((i + 1) * root.row-height > root.visible-height - root.content-y) {
            root.content-y = root.visible-height - (i + 1) * root.row-height;
        }
        root.cursor = i;
    }

    for r[i] in root.rows: RowView {
        entry: r;
        selected: i == root.selected;
        current: i == root.cursor;
        primary-label: root.primary-label;
        clicked => { root.chosen(i); }
        primary => { root.primary(i); }
        focused => { root.cursor = i; }
        step(d) => { root.go(i + d); }
    }
}

// The same for a short list laid out in a page rather than scrolling by itself.
// The row's own button says what it does (its aside), when `aside-is-action`.
component RowGroup inherits VerticalLayout {
    in property <[Row]> rows;
    in property <string> primary-label;
    in property <bool> aside-is-action;
    callback primary(int);
    property <int> cursor: -1;
    for r[i] in root.rows: RowView {
        entry: r;
        current: i == root.cursor;
        primary-label: root.aside-is-action ? r.aside : root.primary-label;
        primary => {
            if (!root.aside-is-action || r.aside != "") { root.primary(i); }
        }
        focused => { root.cursor = i; }
        step(d) => {
            if (i + d >= 0 && i + d < root.rows.length) { root.cursor = i + d; }
        }
    }
}

component DialKey inherits Pressable {
    in property <string> digit;
    in property <string> letters;
    callback pressed(string);
    width: 72px;
    height: 56px;
    radius: 28px;
    label: digit == "*" ? "star" : digit == "#" ? "hash" : digit;
    activated => { root.pressed(digit); }
    Rectangle {
        border-radius: 28px;
        background: root.down ? Palette.selection-background : root.hovered ? Palette.alternate-background : Palette.control-background;
    }
    VerticalLayout {
        alignment: center;
        Text { text: digit; font-size: 22px; horizontal-alignment: center; color: Palette.foreground; }
        Text { text: letters; font-size: 12px; horizontal-alignment: center; color: Brand.muted; letter-spacing: 1px; }
    }
}

component Dialpad inherits VerticalLayout {
    in-out property <string> number;
    in property <string> hint;
    callback call(string);
    callback typed(string);
    spacing: 10px;
    alignment: start;
    LineEdit {
        text <=> root.number;
        accessible-label: "Number to call";
        placeholder-text: "Number or *code#";
        font-size: 20px;
        horizontal-alignment: center;
        accepted => { root.call(root.number); }
        edited => { root.typed(self.text); }
    }
    Text { text: hint; horizontal-alignment: center; color: Brand.muted; height: 16px; }
    for row in [["1", "", "2", "ABC", "3", "DEF"], ["4", "GHI", "5", "JKL", "6", "MNO"], ["7", "PQRS", "8", "TUV", "9", "WXYZ"], ["*", "", "0", "+", "#", ""]]: HorizontalLayout {
        alignment: center;
        spacing: 14px;
        DialKey { digit: row[0]; letters: row[1]; pressed(d) => { root.number += d; root.typed(root.number); } }
        DialKey { digit: row[2]; letters: row[3]; pressed(d) => { root.number += d; root.typed(root.number); } }
        DialKey { digit: row[4]; letters: row[5]; pressed(d) => { root.number += d; root.typed(root.number); } }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 14px;
        Rectangle { width: 72px; }
        callk := Pressable {
            width: 72px; height: 56px; radius: 28px;
            label: "Call";
            activated => { root.call(root.number); }
            Rectangle { border-radius: 28px; background: callk.hovered ? Brand.ok.darker(10%) : Brand.ok; }
            Text { text: "Call"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        Pressable {
            width: 72px; height: 56px; radius: 28px;
            label: "Clear number";
            enabled: root.number != "";
            activated => { root.number = ""; root.typed(""); }
            Text { text: root.number == "" ? "" : "Clear"; color: Brand.muted; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// The card that sits over everything while a call rings or is live.
component CallCard inherits Rectangle {
    in property <bool> ringing;
    in property <bool> waiting;
    in property <string> name;
    in property <string> detail;
    in property <string> timer;
    in property <bool> muted;
    in property <bool> two-calls;
    in property <string> held-name;
    in property <[Choice]> routes;
    in property <[string]> route-names;
    in property <int> route-index;
    in property <bool> keypad;
    callback answer();
    callback decline();
    callback hangup();
    callback mute(bool);
    callback swap();
    callback route(int);
    callback dtmf(string);
    callback toggle-keypad();
    callback reply(string);

    width: 420px;
    height: inner.preferred-height + 40px;
    border-radius: 16px;
    background: Palette.background;
    drop-shadow-blur: 24px;
    drop-shadow-color: #0006;
    border-width: 1px;
    border-color: ringing ? Brand.accent : Palette.border;

    inner := VerticalLayout {
        padding: 20px;
        spacing: 12px;
        Text {
            text: ringing ? (waiting ? "Call waiting" : "Incoming call") : (timer == "" ? "Calling..." : timer);
            horizontal-alignment: center;
            color: ringing ? Brand.accent : Brand.muted;
            font-weight: 600;
        }
        Text { text: name; font-size: 26px; font-weight: 700; horizontal-alignment: center; overflow: elide; color: Palette.foreground; }
        Text { text: detail; horizontal-alignment: center; color: Brand.muted; visible: detail != ""; }
        if two-calls && !ringing: Text { text: "On hold: " + held-name; horizontal-alignment: center; color: Brand.muted; }

        // Ringing: the focus starts on Answer, and Tab goes round the card's own
        // buttons rather than out to the page behind it.
        if ringing: Rectangle {
            init => { answer-button.focus(); }
            FocusWrap { wrap => { reply-3.focus(); } }
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    decline-button := Button { text: "Decline"; clicked => { root.decline(); } }
                    answer-button := Button { text: "Answer"; primary: true; clicked => { root.answer(); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button { text: "Can't talk now"; clicked => { root.reply(self.text); } }
                    Button { text: "On my way"; clicked => { root.reply(self.text); } }
                    reply-3 := Button { text: "Call you back"; clicked => { root.reply(self.text); } }
                }
            }
            FocusWrap { wrap => { decline-button.focus(); } }
        }

        // Live: the focus starts on Keypad, which nothing harms (End is the last
        // place for it, a moment after answering).
        if !ringing: Rectangle {
            init => { keypad-button.focus(); }
            FocusWrap { wrap => { end-button.focus(); } }
            VerticalLayout {
                spacing: 12px;
                if keypad: HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    for d in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "*", "0", "#"]: Button {
                        text: d;
                        width: 28px;
                        accessible-label: d == "*" ? "star" : d == "#" ? "hash" : d;
                        clicked => { root.dtmf(d); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    mute-button := Button { text: muted ? "Unmute" : "Mute"; checkable: true; checked: muted; clicked => { root.mute(!muted); } }
                    keypad-button := Button { text: "Keypad"; checkable: true; checked: keypad; clicked => { root.toggle-keypad(); } }
                    if two-calls: Button { text: "Swap"; clicked => { root.swap(); } }
                    ComboBox {
                        horizontal-stretch: 1;
                        accessible-label: "Call audio";
                        model: route-names;
                        current-index: route-index;
                        selected => { root.route(self.current-index); }
                    }
                }
                end-button := Pressable {
                    height: 44px;
                    radius: 22px;
                    label: "End call";
                    activated => { root.hangup(); }
                    Rectangle { border-radius: 22px; background: end-button.hovered ? Brand.danger.darker(10%) : Brand.danger; }
                    Text { text: "End call"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            FocusWrap { wrap => { mute-button.focus(); } }
        }
    }
}

export component AppWindow inherits Window {
    title: "Dolphone";
    preferred-width: 980px;
    preferred-height: 660px;
    min-width: 720px;
    min-height: 520px;
    background: Palette.background;

    // 0 calls, 1 messages, 2 contacts, 3 settings.
    in-out property <int> page;

    // The sidebar's view of the phone.
    in property <string> operator;
    in property <string> signal;
    // The signal in words ("LTE, signal 3 of 4"), for a screen reader.
    in property <string> signal-label;
    in property <int> unread;
    in property <int> missed;
    in property <bool> connected;

    // Calls.
    in-out property <string> number;
    in property <string> number-hint;
    in property <[Row]> recents;
    in-out property <int> recent-selected: -1;

    // Messages.
    in property <[Row]> threads;
    in-out property <string> search-text;
    in property <[Row]> found;
    in-out property <int> thread-selected: -1;
    in property <string> thread-title;
    in property <string> thread-number;
    in property <[Bubble]> bubbles;
    in-out property <string> draft;
    in property <string> draft-cost;

    // Contacts.
    in property <[Row]> contacts;
    in-out property <int> contact-selected: -1;
    in-out property <string> contact-filter;
    in-out property <string> new-contact-name;
    in-out property <string> new-contact-number;
    // Paired phones, to copy contacts from.
    in property <[Row]> phones;

    // Settings.
    in property <[Choice]> routes: [{label: "Speaker"}, {label: "Headset"}, {label: "Bluetooth"}];
    in property <[string]> route-names: ["Speaker", "Headset", "Bluetooth"];
    in property <int> route-index;
    in property <int> ringer-index;
    in property <int> hold-index;
    in property <[Toggle]> call-toggles;
    in property <[Toggle]> text-toggles;
    in property <[Toggle]> alert-toggles;
    in-out property <string> voicemail;
    in-out property <string> uplink-to;
    in-out property <string> uplink-iface;
    in property <bool> sip-enabled;
    in-out property <string> sip-account;
    in-out property <string> sip-password;
    in-out property <string> sip-proxy;
    in property <bool> sip-always;
    in property <bool> sip-password-set;
    in property <string> sip-status;
    in property <[Row]> grants;
    in property <bool> kdeconnect;
    in property <[Row]> laptops;
    in property <[Row]> audit;
    in property <[Row]> alerts;
    in property <bool> bt-available;
    in property <bool> bt-powered;
    in property <[Row]> bt-devices;
    in property <[Row]> blocked;
    in property <string> modem-text;

    // The call card.
    in property <bool> call-visible;
    in property <bool> call-ringing;
    in property <bool> call-waiting;
    in property <string> call-name;
    in property <string> call-detail;
    in property <string> call-timer;
    in property <bool> call-muted;
    in property <bool> call-two;
    in property <string> call-held-name;
    in-out property <bool> call-keypad;

    // A confirmation phoned is holding.
    in property <bool> confirm-visible;
    in property <string> confirm-title;
    in property <string> confirm-body;
    in property <string> confirm-reason;

    // An emergency alert, over everything until dismissed.
    in property <bool> alert-visible;
    in property <string> alert-title;
    in property <string> alert-text;
    in property <string> alert-time;

    // A passing message.
    in property <string> toast;

    callback navigate(int);
    callback dial(string);
    callback number-typed(string);
    callback recent-call(int);
    callback recent-text(int);
    callback open-thread(int);
    callback search(string);
    callback open-found(int);
    callback export-texts();
    callback send(string);
    callback draft-edited(string);
    callback new-message(string);
    callback thread-call();
    callback thread-block();
    callback thread-delete();
    callback contact-call(int);
    callback contact-text(int);
    callback contacts-filtered(string);
    callback answer();
    callback decline();
    callback hangup();
    callback mute(bool);
    callback swap();
    callback route(int);
    callback dtmf(string);
    callback reply(string);
    callback allow();
    callback deny();
    callback set-ringer(int);
    callback set-hold(int);
    callback set-flag(string, bool);
    callback bt-power(bool);
    callback bt-scan();
    callback bt-action(int);
    callback unblock(int);
    callback wipe();
    callback copy(string, bool);
    callback set-voicemail(string);
    callback save-uplink(string, string);
    callback save-sip(string, string, string, bool);
    callback revoke(int);
    callback unpair-laptop(int);
    callback dismiss-alert();
    callback add-contact(string, string);
    callback remove-contact(int);
    callback import-from-phone(int);

    // Keyboard shortcuts, for whatever has focus that does not use the key itself:
    // Ctrl+1..4 the pages, Ctrl+N a new message, and for a call Ctrl+Enter answers,
    // Ctrl+Backspace declines or hangs up, Ctrl+M mutes.
    shortcuts := FocusScope {
        key-pressed(event) => {
            if (!event.modifiers.control) { return reject; }
            if (event.text == "1") { root.navigate(0); return accept; }
            if (event.text == "2") { root.navigate(1); return accept; }
            if (event.text == "3") { root.navigate(2); return accept; }
            if (event.text == "4") { root.navigate(3); return accept; }
            if (event.text == "n" || event.text == "N") { root.navigate(1); root.new-message(""); return accept; }
            if (event.text == Key.Return && root.call-ringing) { root.answer(); return accept; }
            if (event.text == Key.Backspace && root.call-visible) {
                if (root.call-ringing) { root.decline(); } else { root.hangup(); }
                return accept;
            }
            if ((event.text == "m" || event.text == "M") && root.call-visible && !root.call-ringing) {
                root.mute(!root.call-muted);
                return accept;
            }
            reject
        }

    HorizontalLayout {
        // Sidebar.
        Rectangle {
            width: 220px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 14px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Dolphone"; font-size: 24px; font-weight: 800; color: Brand.accent; }
                }
                Text { text: connected ? operator : "Phone service not running"; color: Brand.muted; font-size: 12px; overflow: elide; }
                Text { text: signal; color: Brand.muted; font-size: 12px; accessible-label: root.signal-label; }
                Rectangle { height: 14px; }
                NavItem { label: "Calls"; glyph: "\u{260E}"; active: page == 0; badge: missed; clicked => { root.navigate(0); } }
                NavItem { label: "Messages"; glyph: "\u{2709}"; active: page == 1; badge: unread; clicked => { root.navigate(1); } }
                NavItem { label: "Contacts"; glyph: "\u{263A}"; active: page == 2; clicked => { root.navigate(2); } }
                NavItem { label: "Settings"; glyph: "\u{2699}"; active: page == 3; clicked => { root.navigate(3); } }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Not for emergency calls."; font-size: 12px; color: Brand.muted; wrap: word-wrap; }
            }
        }

        // The page.
        Rectangle {
            horizontal-stretch: 1;
            if page == 0: HorizontalLayout {
                padding: 20px;
                spacing: 24px;
                Dialpad {
                    width: 260px;
                    number <=> root.number;
                    hint: root.number-hint;
                    call(n) => { root.dial(n); }
                    typed(t) => { root.number-typed(t); }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text { text: "Recent calls"; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                    RowList {
                        rows: root.recents;
                        selected: root.recent-selected;
                        primary-label: "Call";
                        chosen(i) => { root.recent-selected = i; }
                        primary(i) => { root.recent-call(i); }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button { text: "Text"; enabled: root.recent-selected >= 0; clicked => { root.recent-text(root.recent-selected); } }
                        Button { text: "Call back"; primary: true; enabled: root.recent-selected >= 0; clicked => { root.recent-call(root.recent-selected); } }
                    }
                }
            }

            if page == 1: HorizontalLayout {
                Rectangle {
                    width: 300px;
                    border-width: 0px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            Text { text: "Messages"; font-size: 18px; font-weight: 700; horizontal-stretch: 1; color: Palette.foreground; }
                            Button { text: "New"; clicked => { root.new-message(root.contact-filter); } }
                        }
                        LineEdit {
                            placeholder-text: "Search texts";
                            accessible-label: "Search texts";
                            text <=> root.search-text;
                            edited => { root.search(self.text); }
                        }
                        if root.search-text != "": RowList {
                            rows: root.found;
                            chosen(i) => { root.open-found(i); }
                            primary(i) => { root.open-found(i); }
                        }
                        if root.search-text == "": RowList {
                            rows: root.threads;
                            selected: root.thread-selected;
                            chosen(i) => { root.thread-selected = i; root.open-thread(i); }
                            primary(i) => { root.thread-selected = i; root.open-thread(i); }
                        }
                    }
                }
                Rectangle { width: 1px; background: Palette.border; }
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    if root.thread-title == "": Text {
                        text: "Choose a conversation, or start a new one.";
                        color: Brand.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                    }
                    if root.thread-title != "": HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text { text: root.thread-title; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                            Text { text: root.thread-number; font-size: 12px; color: Brand.muted; }
                        }
                        Button { text: "Call"; clicked => { root.thread-call(); } }
                        Button { text: "Block"; clicked => { root.thread-block(); } }
                        Button { text: "Delete"; clicked => { root.thread-delete(); } }
                    }
                    if root.thread-title != "": ListView {
                        vertical-stretch: 1;
                        for b in root.bubbles: HorizontalLayout {
                            padding: 4px;
                            alignment: b.mine ? end : start;
                            Rectangle {
                                max-width: 420px;
                                border-radius: 14px;
                                background: b.mine ? Brand.bubble : Palette.alternate-background;
                                // Whose it is shows only in its colour and side; the
                                // label says it, with the time and how it went.
                                accessible-role: text;
                                accessible-label: b.label;
                                VerticalLayout {
                                    padding: 10px;
                                    padding-top: 7px;
                                    padding-bottom: 7px;
                                    if b.picture.width > 0: Image {
                                        source: b.picture;
                                        max-width: 400px;
                                        max-height: 300px;
                                        image-fit: contain;
                                        accessible-role: image;
                                        accessible-label: "Picture";
                                    }
                                    if b.text != "": Text { text: b.text; wrap: word-wrap; color: b.mine ? white : Palette.foreground; }
                                    if b.parts != "": Text { text: b.parts; font-italic: true; color: b.mine ? white : Palette.foreground; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        if b.code != "": Button {
                                            text: "Copy code " + b.code;
                                            primary: true;
                                            clicked => { root.copy(b.code, true); }
                                        }
                                        Text { text: b.time + (b.state == "" ? "" : "  " + b.state); font-size: 12px; color: b.mine ? #fffc : Brand.muted; horizontal-alignment: right; vertical-alignment: center; horizontal-stretch: 1; }
                                        // A quiet link rather than a button on every bubble.
                                        copy-link := Pressable {
                                            width: copy-label.preferred-width;
                                            radius: 3px;
                                            label: "Copy message";
                                            activated => { root.copy(b.text, false); }
                                            copy-label := Text {
                                                text: "Copy";
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                color: b.mine ? #fffc : Brand.muted;
                                                font-weight: copy-link.hovered || copy-link.has-focus ? 700 : 400;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.thread-title != "": HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.draft;
                            accessible-label: "Text message";
                            placeholder-text: "Text message";
                            edited => { root.draft-edited(self.text); }
                            accepted => { root.send(root.draft); }
                        }
                        Text { text: root.draft-cost; color: Brand.muted; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Send"; primary: true; enabled: root.draft != ""; clicked => { root.send(root.draft); } }
                    }
                }
            }

            if page == 2: VerticalLayout {
                padding: 20px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Contacts"; font-size: 18px; font-weight: 700; horizontal-stretch: 1; color: Palette.foreground; }
                    LineEdit {
                        width: 240px;
                        accessible-label: "Search contacts";
                        placeholder-text: "Search";
                        text <=> root.contact-filter;
                        edited => { root.contacts-filtered(self.text); }
                    }
                }
                RowList {
                    rows: root.contacts;
                    selected: root.contact-selected;
                    primary-label: "Call";
                    chosen(i) => { root.contact-selected = i; }
                    primary(i) => { root.contact-call(i); }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Text { text: "Contacts are .vcf files in ~/.local/share/dolphone/contacts"; color: Brand.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                    Button { text: "Delete"; enabled: root.contact-selected >= 0; clicked => { root.remove-contact(root.contact-selected); } }
                    Button { text: "Text"; enabled: root.contact-selected >= 0; clicked => { root.contact-text(root.contact-selected); } }
                    Button { text: "Call"; primary: true; enabled: root.contact-selected >= 0; clicked => { root.contact-call(root.contact-selected); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: "Name"; accessible-label: "New contact's name"; text <=> root.new-contact-name; }
                    LineEdit { placeholder-text: "Number"; accessible-label: "New contact's number"; text <=> root.new-contact-number; accepted => { root.add-contact(root.new-contact-name, root.new-contact-number); } }
                    Button {
                        text: "Add contact";
                        enabled: root.new-contact-name != "" && root.new-contact-number != "";
                        clicked => { root.add-contact(root.new-contact-name, root.new-contact-number); }
                    }
                }
                if root.phones.length > 0: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "Copy names and numbers from a paired phone (no account needed):"; color: Brand.muted; vertical-alignment: center; }
                    for p[i] in root.phones: Button { text: p.title; clicked => { root.import-from-phone(i); } }
                }
            }

            if page == 3: ScrollView {
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    alignment: start;
                    Text { text: "Settings"; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Ringer"; width: 180px; vertical-alignment: center; color: Palette.foreground; }
                        ComboBox { accessible-label: "Ringer"; model: ["Ring", "Vibrate", "Silent"]; current-index: root.ringer-index; selected => { root.set-ringer(self.current-index); } }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Hold time on the panel"; width: 180px; vertical-alignment: center; color: Palette.foreground; }
                        ComboBox { accessible-label: "Hold time on the panel"; model: ["0.4 s", "0.6 s", "0.8 s", "1 s", "1.5 s", "2 s", "3 s"]; current-index: root.hold-index; selected => { root.set-hold(self.current-index); } }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Call audio"; width: 180px; vertical-alignment: center; color: Palette.foreground; }
                        ComboBox { accessible-label: "Call audio"; model: root.route-names; current-index: root.route-index; selected => { root.route(self.current-index); } }
                    }
                    Text { text: "Calls"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Voicemail number"; width: 180px; vertical-alignment: center; color: Palette.foreground; }
                        LineEdit {
                            width: 200px;
                            text <=> root.voicemail;
                            accessible-label: "Voicemail number";
                            placeholder-text: "Your carrier's, e.g. 101";
                            input-type: InputType.text;
                            accepted => { root.set-voicemail(self.text); }
                        }
                        Button { text: "Save"; width: 90px; clicked => { root.set-voicemail(root.voicemail); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    for t in root.call-toggles: CheckBox { text: t.label; checked: t.on; toggled => { root.set-flag(t.key, self.checked); } }

                    Text { text: "Calls over the internet (SIP)"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    CheckBox { text: "Use a SIP account for calls"; checked: root.sip-enabled; toggled => { root.set-flag("sip_enabled", self.checked); } }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Account"; width: 180px; vertical-alignment: center; color: Palette.foreground; }
                        LineEdit { text <=> root.sip-account; accessible-label: "SIP account"; placeholder-text: "sip:you@voip.example.net"; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Password"; width: 180px; vertical-alignment: center; color: Palette.foreground; }
                        LineEdit {
                            text <=> root.sip-password;
                            accessible-label: root.sip-password-set ? "SIP password, saved; type to change" : "SIP password";
                            input-type: InputType.password;
                            placeholder-text: root.sip-password-set ? "Saved; type to change" : "The account's password";
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Outbound proxy"; width: 180px; vertical-alignment: center; color: Palette.foreground; }
                        LineEdit { text <=> root.sip-proxy; accessible-label: "SIP outbound proxy"; placeholder-text: "Only if your provider gives one"; }
                    }
                    sip-always-box := CheckBox { text: "Use it for every call, not only when there is no mobile signal"; checked: root.sip-always; }
                    HorizontalLayout {
                        spacing: 12px;
                        // Registered says so with a mark and in words, not by its green alone.
                        Text {
                            text: root.sip-status == "" ? "Off" : root.sip-status == "registered" ? "\u{2713} Registered" : root.sip-status;
                            accessible-label: "SIP account: " + (root.sip-status == "" ? "off" : root.sip-status);
                            color: root.sip-status == "registered" ? Brand.ok : Brand.muted;
                            font-weight: root.sip-status == "registered" ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button { text: "Save account"; clicked => { root.save-sip(root.sip-account, root.sip-password, root.sip-proxy, sip-always-box.checked); } }
                    }
                    Text { text: "Emergency calls always go over the mobile network."; color: Brand.muted; font-size: 12px; }

                    Text { text: "Texts"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    for t in root.text-toggles: CheckBox { text: t.label; checked: t.on; toggled => { root.set-flag(t.key, self.checked); } }

                    Text { text: "Uplink watch"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    Text { text: "Text a number when the network link drops, and when it comes back."; color: Brand.muted; }
                    HorizontalLayout {
                        spacing: 12px;
                        LineEdit { width: 200px; text <=> root.uplink-to; accessible-label: "Number to text when the link drops"; placeholder-text: "Number to text (empty: off)"; }
                        LineEdit { width: 160px; text <=> root.uplink-iface; accessible-label: "Interface to watch"; placeholder-text: "Interface (any)"; }
                        Button { text: "Save"; width: 90px; clicked => { root.save-uplink(root.uplink-to, root.uplink-iface); } }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    Text { text: "Emergency alerts"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    CheckBox { text: "National alerts (always on)"; checked: true; enabled: false; }
                    for t in root.alert-toggles: CheckBox { text: t.label; checked: t.on; toggled => { root.set-flag(t.key, self.checked); } }
                    RowGroup { rows: root.alerts; }

                    Text { text: "Bluetooth"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    if !root.bt-available: Text { text: "No Bluetooth adapter."; color: Brand.muted; }
                    if root.bt-available: HorizontalLayout {
                        spacing: 12px;
                        Switch { text: "Bluetooth"; checked: root.bt-powered; toggled => { root.bt-power(self.checked); } }
                        Button { text: "Scan for headsets and speakers"; enabled: root.bt-powered; clicked => { root.bt-scan(); } }
                    }
                    RowGroup {
                        rows: root.bt-devices;
                        aside-is-action: true;
                        primary(i) => { root.bt-action(i); }
                    }

                    Text { text: "Blocked numbers"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    if root.blocked.length == 0: Text { text: "Nobody is blocked."; color: Brand.muted; }
                    RowGroup {
                        rows: root.blocked;
                        primary-label: "Unblock";
                        primary(i) => { root.unblock(i); }
                    }

                    Text { text: "Laptops (KDE Connect)"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    CheckBox {
                        text: "Let laptops with KDE Connect or GSConnect see calls and texts (listens on the local network)";
                        checked: root.kdeconnect;
                        toggled => { root.set-flag("kdeconnect", self.checked); }
                    }
                    RowGroup {
                        rows: root.laptops;
                        aside-is-action: true;
                        primary(i) => { root.unpair-laptop(i); }
                    }

                    Text { text: "Programs allowed to text"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    if root.grants.length == 0: Text {
                        text: "None. A program asks with Settings.RequestGrant and you allow it once, here or on the panel.";
                        color: Brand.muted;
                        wrap: word-wrap;
                    }
                    RowGroup {
                        rows: root.grants;
                        primary-label: "Revoke";
                        primary(i) => { root.revoke(i); }
                    }

                    Text { text: "What programs asked for"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    if root.audit.length == 0: Text { text: "Nothing yet."; color: Brand.muted; }
                    RowGroup { rows: root.audit; }

                    Text { text: "Modem"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    Text { text: root.modem-text; color: Brand.muted; wrap: word-wrap; }

                    Text { text: "Your texts"; font-size: 15px; font-weight: 700; color: Palette.foreground; }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Button { text: "Export texts..."; clicked => { root.export-texts(); } }
                        Text {
                            text: "An SMS Backup & Restore file in Documents, which Android phones can import. It is not encrypted, and only you can open it: delete it once it is copied over.";
                            color: Brand.muted;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }

                    Text { text: "Danger zone"; font-size: 15px; font-weight: 700; color: Brand.danger; }
                    HorizontalLayout {
                        alignment: start;
                        Button { text: "Delete all texts, calls and blocks..."; clicked => { root.wipe(); } }
                    }
                }
            }
        }
    }

    // A dim layer under the card and the confirmation, so they read as on top.
    // These are inside the shortcuts' scope, so Ctrl+Enter and Ctrl+Backspace
    // still work while the focus is on the card.
    if call-visible || confirm-visible || alert-visible: Rectangle {
        background: #0005;
        TouchArea {}
    }

    if call-visible: CallCard {
        x: (root.width - self.width) / 2;
        y: 40px;
        ringing: root.call-ringing;
        waiting: root.call-waiting;
        name: root.call-name;
        detail: root.call-detail;
        timer: root.call-timer;
        muted: root.call-muted;
        two-calls: root.call-two;
        held-name: root.call-held-name;
        routes: root.routes;
        route-index: root.route-index;
        route-names: root.route-names;
        keypad: root.call-keypad;
        answer => { root.answer(); }
        decline => { root.decline(); }
        hangup => { root.hangup(); }
        mute(m) => { root.mute(m); }
        swap => { root.swap(); }
        route(r) => { root.route(r); }
        dtmf(d) => { root.dtmf(d); }
        toggle-keypad => { root.call-keypad = !root.call-keypad; }
        reply(t) => { root.reply(t); }
    }

    if confirm-visible && !call-visible: Rectangle {
        x: (root.width - self.width) / 2;
        y: 80px;
        width: 420px;
        height: cbox.preferred-height + 20px;
        border-radius: 16px;
        background: Palette.background;
        border-width: 2px;
        border-color: Brand.accent;
        drop-shadow-blur: 24px;
        drop-shadow-color: #0006;
        // The focus starts on Deny, the answer that does nothing, and Tab stays
        // on the two buttons.
        init => { deny-button.focus(); }
        FocusWrap { wrap => { allow-button.focus(); } }
        cbox := VerticalLayout {
            padding: 20px;
            spacing: 10px;
            Text { text: root.confirm-title; font-size: 18px; font-weight: 700; wrap: word-wrap; color: Palette.foreground; }
            Text { text: root.confirm-body; wrap: word-wrap; color: Palette.foreground; visible: root.confirm-body != ""; }
            Text { text: root.confirm-reason; color: Brand.accent; font-weight: 600; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                deny-button := Button { text: "Deny"; clicked => { root.deny(); } }
                allow-button := Button { text: "Allow"; primary: true; clicked => { root.allow(); } }
            }
        }
        FocusWrap { wrap => { deny-button.focus(); } }
    }

    if alert-visible && !call-visible: Rectangle {
        x: (root.width - self.width) / 2;
        y: 60px;
        width: min(root.width - 80px, 560px);
        height: abox.preferred-height + 20px;
        border-radius: 16px;
        background: Brand.danger;
        drop-shadow-blur: 24px;
        drop-shadow-color: #0008;
        accessible-role: groupbox;
        accessible-label: root.alert-title;
        // Dismiss has the focus, and keeps it.
        init => { dismiss-button.focus(); }
        FocusWrap { wrap => { dismiss-button.focus(); } }
        abox := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            HorizontalLayout {
                Text { text: root.alert-title; font-size: 22px; font-weight: 800; color: white; horizontal-stretch: 1; }
                Text { text: root.alert-time; color: white; vertical-alignment: center; }
            }
            Text { text: root.alert-text; font-size: 16px; wrap: word-wrap; color: white; }
            HorizontalLayout {
                alignment: end;
                dismiss-button := Button { text: "Dismiss"; primary: true; clicked => { root.dismiss-alert(); } }
            }
        }
        FocusWrap { wrap => { dismiss-button.focus(); } }
    }

    if toast != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 24px;
        width: min(root.width - 80px, tt.preferred-width + 32px);
        height: 40px;
        border-radius: 20px;
        background: #222e;
        tt := Text { text: root.toast; color: white; horizontal-alignment: center; vertical-alignment: center; }
    }
    }
}
